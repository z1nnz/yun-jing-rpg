{
  "name": "yun-jing-rpg",
  "version": "0.1.0",
  "private": true,
  "description": "雲境：獨立多人修仙專案",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/services/api/src/main.js",
    "dev": "npm run build && npm start",
