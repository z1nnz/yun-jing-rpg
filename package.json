    "typecheck": "tsc --noEmit",
    "smoke": "node dist/tools/smoke.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "firebase-admin": "14.5.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "jsdom": "26.1.0",
    "typescript": "5.8.3"
  }
}
